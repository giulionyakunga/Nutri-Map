        {
          "name": "Get producer full profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/producers/11/profile",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Create producer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/producers",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"businessName\": \"Jitihada Mazao Group\",\n  \"ownershipStructure\": \"Registered Farmer Association\",\n  \"contactPerson\": \"Mariam Magesa\",\n  \"positionRole\": \"Production Manager\",\n  \"phone\": \"700000010\",\n  \"physicalAddress\": \"Near Bunju Market, Bunju, Dar es Salaam\",\n  \"regionId\": 1,\n  \"latitude\": -6.624487,\n  \"longitude\": 39.147812,\n  \"operationalStatus\": \"Active (Operating year-round)\",\n  \"operationalScale\": \"Micro-enterprise (< 5 employees)\",\n  \"primaryRawMaterials\": [\n    \"Soybeans\",\n    \"Maize\"\n  ],\n  \"nutrientDenseCrops\": [\n    \"Edible Seaweed\",\n    \"Orange-Fleshed Sweet Potato\"\n  ]\n}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Update producer",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/producers/11",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dailyOutput\": 500,\n  \"verificationStatus\": \"field_validated\"\n}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Delete (soft) producer",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/producers/11",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]

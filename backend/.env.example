NODE_ENV=development
PORT=4000

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=nutrimap_user
DB_PASSWORD=change_this_password
DB_NAME=nutri_map
DB_NAME_TEST=nutri_map_test
DB_SSL=false

DATABASE_URL=postgres://nutrimap_user:change_this_password@127.0.0.1:5432/nutri_map

JWT_ACCESS_SECRET=replace_with_a_long_random_value
JWT_REFRESH_SECRET=replace_with_a_different_long_random_value
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

BCRYPT_SALT_ROUNDS=12

CORS_ALLOWED_ORIGINS=http://localhost:3000

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
